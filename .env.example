# NEXFORM / AI Fitness Coach Pro — local & Vercel env template
# Copy to `.env` and fill real values. Never commit `.env`.

# --- Database (Supabase) ---
# Runtime: Transaction Pooler port 6543 + pgbouncer
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Prisma CLI (migrate/studio): Session/Direct port 5432
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Local Docker only (optional): set ALLOW_LOCAL_DATABASE=true
# DATABASE_URL=postgresql://fitness:fitness_secret@localhost:5432/ai_fitness_coach
# DIRECT_URL=postgresql://fitness:fitness_secret@localhost:5432/ai_fitness_coach
# ALLOW_LOCAL_DATABASE=true

# --- Auth (required) ---
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
NEXTAUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
# AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- AI (optional; Coach / Food Vision) ---
# OPENAI_API_KEY=

# --- Email (optional; verification / password reset) ---
# RESEND_API_KEY=
# EMAIL_FROM=NEXFORM <noreply@example.com>
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# --- Wearables OAuth (optional) ---
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# GARMIN_CLIENT_ID=
# GARMIN_CLIENT_SECRET=
# GOOGLE_FIT_CLIENT_ID=
# GOOGLE_FIT_CLIENT_SECRET=
